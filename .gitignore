# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# pipeline Python (votre §6, §7)
pipeline/.venv/
pipeline/__pycache__/
pipeline/**/__pycache__/
pipeline/data/**/*.json
!pipeline/data/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
